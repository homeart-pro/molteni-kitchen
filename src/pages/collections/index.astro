---
import Base from '../../layouts/Base.astro';
import '../../styles/home.css';
import { collections as collectionsData } from '../../data/collections';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const collections = collectionsData.map((c) => ({
  slug: c.slug,
  name: c.name,
  designer: c.designer ?? '',
  img: `${base}/images/collections/${c.slug}-cover.jpg`,
}));
---
<Base
  title="Коллекции кухонь Molteni&C — Physis, VVD, Ratio, Prime и другие"
  description="Все 8 кухонных коллекций Molteni&C: Physis, VVD, Intersection, Ratio, Prime, Hi-Line 6, Tivalì 2.0, Helios. Официальный дилер в России."
  headerTransparent={false}
>
  <section class="home-top">
    <div class="container">
      <span class="home-top__eyebrow">( Кухни · 8 )</span>
      <p class="home-top__lead">
        Все кухонные коллекции Molteni&amp;C, доступные через официального дилера в России.
      </p>
      <div class="home-collections">
        {collections.map(c => (
          <a href={`${base}/collections/${c.slug}`} class="collection-card">
            <div class="collection-card__img-wrap">
              <img src={c.img} alt={c.name} loading="lazy" />
            </div>
            <p class="collection-card__caption">
              <strong>{c.name.toUpperCase()}</strong> КУХНИ{c.designer && <> · <em>{c.designer.toUpperCase()}</em></>}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
