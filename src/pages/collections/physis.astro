---
import Base from '../../layouts/Base.astro';
import '../../styles/physis.css';
import { collections } from '../../data/collections';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const others = collections.filter((c) => c.slug !== 'physis').slice(0, 2);

const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Physis — Molteni&C',
  description: 'Physis — кухня Molteni&C от Vincent Van Duysen. Натуральный камень, архитектурная точность.',
  brand: { '@type': 'Brand', name: 'Molteni&C' },
  creator: { '@type': 'Person', name: 'Vincent Van Duysen' },
  image: new URL(`${base}/images/collections/physis-cover.jpg`, Astro.site).toString(),
  countryOfOrigin: 'IT',
};
---
<Base
  title="Physis — кухня Molteni&C | Vincent Van Duysen"
  description="Physis — кухня Molteni&C от Vincent Van Duysen. Натуральный камень, архитектурная точность, Made in Italy."
>
  <script type="application/ld+json" set:html={JSON.stringify(productLd)} />

  <!-- 1. HERO -->
  <section class="physis-hero">
    <img src={`${base}/images/collections/physis/hero.jpg`}
         alt="Кухня Physis — Molteni&C"
         class="physis-hero__bg"
         loading="eager" fetchpriority="high" />
    <div class="physis-hero__overlay"></div>
    <div class="physis-hero__content container">
      <span class="physis-hero__badge">Vincent Van Duysen</span>
      <h1 class="physis-hero__title">Physis</h1>
      <p class="physis-hero__subtitle">Природный камень и архитектурная строгость</p>
    </div>
  </section>

  <!-- 2. INTRO -->
  <section class="section section--warm">
    <div class="container physis-intro">
      <div class="physis-intro__text">
        <h2 class="physis-intro__name">Physis</h2>
        <p class="physis-intro__lead">Кухня, где камень становится архитектурой.</p>
        <p class="physis-intro__body">
          Physis — результат сотрудничества Molteni&amp;C с бельгийским архитектором Vincent Van Duysen.
          Коллекция построена вокруг массивных монолитных объёмов из натурального камня, подчёркивающих
          плотность и тактильность материала. Простые геометрические формы, скрытая фурнитура и
          безупречные пропорции создают ощущение спокойствия и строгой красоты.
        </p>
        <p class="physis-intro__body">
          Столешницы и острова выполняются из цельных плит камня, фасады — из натурального шпона
          или лакированного дерева глубоких, приглушённых оттенков.
        </p>
      </div>
      <div class="physis-intro__image">
        <img src={`${base}/images/collections/physis/intro.jpg`} alt="Кухня Physis, общий вид" loading="lazy" data-lightbox />
      </div>
    </div>
  </section>

  <!-- 3-4. CONFIGURATIONS -->
  <section class="section section--white">
    <div class="container">
      <span class="caption">Конфигурации</span>
      <h2 class="heading">Варианты компоновки</h2>
      <div class="physis-configs">
        <div class="physis-config-card">
          <div class="physis-config-card__img-wrap">
            <img src={`${base}/images/collections/physis/config-1.jpg`} alt="Physis — линейная конфигурация" loading="lazy" data-lightbox />
          </div>
          <h3>Линейная</h3>
          <p>Единый монолитный блок вдоль стены, максимум рабочей поверхности.</p>
        </div>
        <div class="physis-config-card">
          <div class="physis-config-card__img-wrap">
            <img src={`${base}/images/collections/physis/config-2.jpg`} alt="Physis — остров" loading="lazy" data-lightbox />
          </div>
          <h3>С островом</h3>
          <p>Отдельно стоящий каменный остров как композиционный центр кухни.</p>
        </div>
        <div class="physis-config-card">
          <div class="physis-config-card__img-wrap">
            <img src={`${base}/images/collections/physis/config-3.jpg`} alt="Physis — угловая конфигурация" loading="lazy" data-lightbox />
          </div>
          <h3>Угловая</h3>
          <p>Компактное решение для интеграции с обеденной зоной.</p>
        </div>
      </div>
      <div class="physis-configs__cta">
        <a href="#form" class="ghost-btn">Свяжитесь с нами для других вариантов</a>
      </div>
    </div>
  </section>

  <!-- 6-7. MATERIALS -->
  <section class="section section--warm">
    <div class="container">
      <h2 class="heading">Отделочные материалы</h2>
      <div class="physis-materials-layout">
        <div class="physis-materials-photos">
          <img src={`${base}/images/collections/physis/material-1.jpg`} alt="Отделка камнем" loading="lazy" data-lightbox />
          <img src={`${base}/images/collections/physis/material-2.jpg`} alt="Отделка деревом" loading="lazy" data-lightbox />
          <img src={`${base}/images/collections/physis/material-3.jpg`} alt="Барные стулья Mollis" loading="lazy" data-lightbox />
        </div>
        <div class="physis-materials-list">
          <h3 class="physis-materials-list__title">Предлагаемые отделки</h3>
          <dl class="physis-materials-dl">
            <dt>Столешница и остров</dt><dd>Натуральный камень, цельная плита</dd>
            <dt>Фасады</dt><dd>Натуральный шпон дерева / лак матовый</dd>
            <dt>Ручки</dt><dd>Скрытые интегрированные профили</dd>
            <dt>Дополнительно</dt><dd>Барные стулья Mollis (Molteni&amp;C)</dd>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- 8-9. DETAILS with tabs -->
  <section class="section section--white">
    <div class="container">
      <div class="physis-tabs-layout">
        <div class="physis-tabs-text">
          <h2 class="heading" style="text-align:left;">Красота в деталях</h2>
          <p class="physis-tabs-body">
            Каждый элемент Physis продуман до миллиметра: скрытые системы хранения,
            интегрированное освещение рабочей зоны, монолитные каменные поверхности без видимых стыков.
          </p>
        </div>
        <div class="physis-tabs-viewer">
          <div class="physis-tabs-image">
            <img class="physis-tabs-img physis-tabs-img--active" src={`${base}/images/collections/physis/tab-1.jpg`} alt="Деталь 1" data-index="0" data-lightbox />
            <img class="physis-tabs-img" src={`${base}/images/collections/physis/tab-2.jpg`} alt="Деталь 2" data-index="1" loading="lazy" data-lightbox />
            <img class="physis-tabs-img" src={`${base}/images/collections/physis/tab-3.jpg`} alt="Деталь 3" data-index="2" loading="lazy" data-lightbox />
          </div>
          <div class="physis-tabs-nav">
            <button class="physis-tab physis-tab--active" data-index="0" data-label="Монолитная столешница">
              <span class="physis-tab__num">01</span>
            </button>
            <button class="physis-tab" data-index="1" data-label="Интегрированное освещение">
              <span class="physis-tab__num">02</span>
            </button>
            <button class="physis-tab" data-index="2" data-label="Скрытые системы хранения">
              <span class="physis-tab__num">03</span>
            </button>
          </div>
          <p class="physis-tabs-active-label" id="physisTabLabel">Монолитная столешница</p>
        </div>
      </div>
    </div>
  </section>

  <!-- DESIGNER — centered composition, deliberately not another split section -->
  <section class="section section--warm">
    <div class="container physis-designer">
      <div class="physis-designer__photo">
        <img src={`${base}/images/collections/physis/designer.jpg`} alt="Vincent Van Duysen" loading="lazy" />
      </div>
      <h2 class="heading physis-designer__name">Vincent Van Duysen</h2>
      <p class="physis-designer__text">
        Бельгийский архитектор, креативный директор Molteni&amp;C с 2016 года. Известен строгим, почти монашеским
        минимализмом и вниманием к материалам: камню, дереву, металлу в их естественном,
        необработанном выражении.
      </p>
    </div>
  </section>

  <!-- 10. FORM -->
  <section class="section section--white" id="form">
    <div class="container physis-form">
      <span class="caption">Консультация</span>
      <h2 class="heading">Обсудить проект<br />из коллекции Physis</h2>
      <p class="physis-form__lead">Персональная консультация по конфигурации и материалам.</p>
      <form class="contact-form">
        <input type="text" name="name" placeholder="Ваше имя" required />
        <input type="tel" name="phone" placeholder="Телефон" required />
        <button type="submit" class="ghost-btn">Отправить</button>
      </form>
      <p class="contact-form__note">Форма — заглушка прототипа, без реальной отправки.</p>
    </div>
  </section>

  <!-- 11. OTHER COLLECTIONS -->
  <section class="section section--warm">
    <div class="container" style="text-align:center;">
      <h2 class="heading">Смотрите также</h2>
      <div class="physis-other-collections">
        {others.map((o) => (
          <a href={`${base}/collections/${o.slug}`} class="physis-other-card">
            <img src={`${base}/images/collections/${o.slug}-cover.jpg`} alt={o.name} loading="lazy" />
            <h3>{o.name}</h3>
            {o.designer && <p>{o.designer}</p>}
          </a>
        ))}
      </div>
    </div>
  </section>

</Base>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    var tabs = document.querySelectorAll('.physis-tab');
    var images = document.querySelectorAll('.physis-tabs-img');
    var label = document.getElementById('physisTabLabel');
    if (!tabs.length || !images.length) return;
    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        var idx = tab.getAttribute('data-index');
        tabs.forEach(function(t) { t.classList.remove('physis-tab--active'); });
        tab.classList.add('physis-tab--active');
        images.forEach(function(img) {
          img.classList.toggle('physis-tabs-img--active', img.getAttribute('data-index') === idx);
        });
        if (label) label.textContent = tab.getAttribute('data-label') || '';
      });
    });
  });
</script>
