---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../../layouts/Base.astro';
import '../../styles/collection.css';
import { collections, type Collection } from '../../data/collections';

export function getStaticPaths() {
  return collections
    .filter((c) => c.slug !== 'physis') // physis has its own richer static page
    .map((c) => ({ params: { slug: c.slug }, props: { collection: c } }));
}

const { collection } = Astro.props as { collection: Collection };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Real photo count per collection, read from disk — no hardcoded numbers to go stale.
const photoDir = path.join(process.cwd(), 'public', 'images', 'collections', collection.slug);
const photoFiles = fs.existsSync(photoDir)
  ? fs
      .readdirSync(photoDir)
      .filter((f) => /^photo-\d+\.jpg$/.test(f))
      .sort()
  : [];
const [introPhoto, ...galleryPhotos] = photoFiles;
// Pair each real paragraph with its own real photo (matches molteni.it: text + photo together,
// not text-block-then-separate-gallery). Leftover photos still get shown in the grid below.
const storyBlocks = collection.body.map((text, i) => ({ text, photo: galleryPhotos[i] }));
const remainingPhotos = galleryPhotos.slice(collection.body.length);

// Content-rich alt text built from the real paragraph/highlight paired with each photo,
// instead of a generic "фото N" — the paragraph already describes what that photo shows.
function altFromText(name: string, text: string, maxLen = 140) {
  const clean = text.replace(/\s*\(источник:[^)]*\)\.?\s*$/i, '').trim();
  if (clean.length <= maxLen) return `${name} — ${clean}`;
  const cut = clean.slice(0, maxLen);
  const lastSpace = cut.lastIndexOf(' ');
  return `${name} — ${cut.slice(0, lastSpace)}…`;
}
function altFromHighlight(name: string, highlights: string[], i: number) {
  return highlights.length > 0 ? `${name} — ${highlights[i % highlights.length]}` : `${name} — деталь кухни`;
}

// Background alternation is computed, not hand-picked — section count before
// Designer/Form/Other varies per collection (story block count differs), so a
// hardcoded warm/white sequence would drift out of sync.
const sectionsBeforeDesigner =
  1 /* intro */ + storyBlocks.length + (collection.highlights.length > 0 ? 1 : 0) + (remainingPhotos.length > 0 ? 1 : 0);
const bg = (index: number) => (index % 2 === 0 ? 'section--warm' : 'section--white');
const designerBg = bg(sectionsBeforeDesigner);
const formBg = bg(sectionsBeforeDesigner + (collection.designer ? 1 : 0));
const otherBg = bg(sectionsBeforeDesigner + (collection.designer ? 1 : 0) + 1);

const others = collections.filter((c) => c.slug !== collection.slug).slice(0, 2);

const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${collection.name} — Molteni&C`,
  description: `${collection.lead} ${collection.body.join(' ')}`.trim(),
  brand: { '@type': 'Brand', name: 'Molteni&C' },
  ...(collection.designer && { creator: { '@type': 'Person', name: collection.designer } }),
  image: new URL(`${base}/images/collections/${collection.slug}-cover.jpg`, Astro.site).toString(),
  countryOfOrigin: 'IT',
};
---
<Base
  title={`${collection.name} — ${collection.outdoor ? 'уличная кухня' : 'кухня'} Molteni&C${collection.designer ? ' | ' + collection.designer : ''}`}
  description={`${collection.name} — ${collection.outdoor ? 'уличная кухня (outdoor)' : 'кухня'} Molteni&C. ${collection.lead} Made in Italy.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(productLd)} />

  <!-- HERO -->
  <section class="col-hero">
    <img src={`${base}/images/collections/${collection.slug}-cover.jpg`}
         alt={`Кухня ${collection.name} — Molteni&C`}
         class="col-hero__bg"
         loading="eager" fetchpriority="high" />
    <div class="col-hero__overlay"></div>
    <div class="col-hero__content container">
      {collection.designer && <span class="col-hero__badge">{collection.designer}</span>}
      <h1 class="col-hero__title">{collection.name}</h1>
      <p class="col-hero__subtitle">{collection.lead}</p>
    </div>
  </section>

  <!-- INTRO -->
  <section class="section section--warm">
    <div class="container col-intro">
      <div>
        <h2 class="col-intro__name">{collection.name}</h2>
        <p class="col-intro__lead">{collection.lead}</p>
        {collection.designer && (
          <p class="col-intro__designer"><strong>Дизайн:</strong> {collection.designer}</p>
        )}
      </div>
      <div class="col-intro__image">
        {introPhoto && (
          <img src={`${base}/images/collections/${collection.slug}/${introPhoto}`} alt={`Кухня ${collection.name}, общий вид`} loading="lazy" data-lightbox />
        )}
      </div>
    </div>
  </section>

  <!-- STORY — each real paragraph paired with its own real photo, alternating sides -->
  {storyBlocks.map((block, i) => (
    <section class={`section ${i % 2 === 0 ? 'section--white' : 'section--warm'}`}>
      <div class={`container col-story ${i % 2 === 1 ? 'col-story--reverse' : ''}`}>
        <p class="col-story__text">{block.text}</p>
        {block.photo && (
          <div class="col-story__image">
            <img src={`${base}/images/collections/${collection.slug}/${block.photo}`} alt={altFromText(collection.name, block.text)} loading="lazy" data-lightbox />
          </div>
        )}
      </div>
    </section>
  ))}

  <!-- HIGHLIGHTS — real, specific facts, shown separately so they don't get lost in prose -->
  {collection.highlights.length > 0 && (
    <section class={`section ${storyBlocks.length % 2 === 0 ? 'section--white' : 'section--warm'}`}>
      <div class="container col-highlights">
        <span class="caption">Особенности</span>
        <ul class="col-highlights__list">
          {collection.highlights.map((h) => <li>{h}</li>)}
        </ul>
      </div>
    </section>
  )}

  <!-- REMAINING PHOTOS — every other real photo, shown as a gallery grid -->
  {remainingPhotos.length > 0 && (
    <section class="section section--white col-detail">
      <div class="container">
        <span class="caption">Ещё фото</span>
        <div class="col-detail__grid">
          {remainingPhotos.map((file, i) => (
            <img src={`${base}/images/collections/${collection.slug}/${file}`} alt={altFromHighlight(collection.name, collection.highlights, i)} loading="lazy" data-lightbox />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- DESIGNER — name and bio only, no photo -->
  {collection.designer && (
    <section class={`section ${designerBg}`}>
      <div class="container col-designer">
        <h2 class="heading col-designer__name">{collection.designer}</h2>
        {collection.designerBio && <p class="col-designer__text">{collection.designerBio}</p>}
      </div>
    </section>
  )}

  <!-- FORM -->
  <section class={`section ${formBg}`} id="form">
    <div class="container col-form">
      <span class="caption">Консультация</span>
      <h2 class="heading">Обсудить проект<br />из коллекции {collection.name}</h2>
      <p class="col-form__lead">Персональная консультация по конфигурации и материалам.</p>
      <form class="contact-form">
        <input type="text" name="name" placeholder="Ваше имя" required />
        <input type="tel" name="phone" placeholder="Телефон" required />
        <button type="submit" class="ghost-btn">Отправить</button>
      </form>
      <p class="contact-form__note">Форма — заглушка прототипа, без реальной отправки.</p>
    </div>
  </section>

  <!-- OTHER COLLECTIONS -->
  <section class={`section ${otherBg}`}>
    <div class="container" style="text-align:center;">
      <span class="caption">Коллекции</span>
      <h2 class="heading">Смотрите также</h2>
      <div class="col-other">
        {others.map((o) => (
          <a href={`${base}/collections/${o.slug}`} class="col-other-card">
            <img src={`${base}/images/collections/${o.slug}-cover.jpg`} alt={o.name} loading="lazy" />
            <h3>{o.name}</h3>
            {o.designer && <p>{o.designer}</p>}
          </a>
        ))}
      </div>
    </div>
  </section>

</Base>
